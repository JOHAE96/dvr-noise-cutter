# Basic-auth credentials Traefik uses to gate the whole app.
# Generate with: htpasswd -nB <username>
# Double every $ in the resulting hash to $$ (verified empirically: a single-$
# hash gets silently mangled — "$abc..." after the salt is parsed by Docker
# Compose as a variable reference and collapses to nothing — so a hash like
# user:$2y$05$abcdefghijklmnopqrstuvwxyz012345678901 must become:
DVR_BASIC_AUTH_USERS=changeme:$$2y$$05$$changemechangemechangemechangeme

# Always run `docker compose config | grep basicauth` before deploying — it
# will still show the $$-doubled form (that's just docker compose's own
# round-trip-safe display, confirmed by testing this repo's compose file with
# both single- and double-$ input: single-$ gets silently truncated because
# the .env parser treats the hash's trailing base64-ish characters as a bare
# ${varname} reference). The doubled form shown by `config` is the correct
# input; verify the actual deployed behavior once by hitting the URL and
# confirming the browser's basic-auth prompt accepts the real password
# (curl -u user:password https://your-host/ -> 200, wrong password -> 401).

